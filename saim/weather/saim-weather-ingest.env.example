# /etc/saim-weather-ingest.env  (root:root 0640 — it holds a NEURO token)
SERIAL_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
SERIAL_BAUD=115200

# Forward accepted readings to NEURO. Leave NEURO_WEATHER_URL empty for journal-only.
NEURO_WEATHER_URL=http://127.0.0.1:3001/api/weather/observations
NEURO_API_TOKEN=<value of NEURO_API_TOKEN from /mnt/data/nuero/backend/.env>
SPOOL_PATH=/var/lib/saim-weather/spool.db

# Journal-only mode during bring-up. MQTT can be enabled later when a broker is selected.
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=saim/weather/outdoor
