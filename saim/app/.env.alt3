# SAiM Alt — the A/B treatment build v3 (`npm run build:alt3`, i.e. `--mode alt3`).
# Committed deliberately: none of these are secrets. The API URL is tailnet-only
# and every call still needs the PIN, which lives in the browser, never here.
# NEVER add VITE_VAULT_API_KEY or any other secret to this file.

VITE_API_URL=https://pi5.tailecb90f.ts.net

# NEURO's own web app — where detailed work and approvals are handed off to.
# The backend serves the NEURO SPA at the same origin as the API.
VITE_NEURO_URL=https://pi5.tailecb90f.ts.net

# The legacy control desktop, linked from the header so the two can be compared.
# Since the 16 Oct 2026 swap it lives at saim-alt (Netlify site saim-legacy-nickward).
VITE_CONTROL_URL=https://saim-alt.nickward.co.uk

# Host guard: this build refuses to run anywhere but its own hosts, so it can
# never be mistaken for (or served as) the control.
# Promoted to saim.nickward.co.uk on 16 Oct 2026 (same Netlify site, saim-alt-nickward).
VITE_ALLOWED_HOSTS=saim.nickward.co.uk,saim-alt-nickward.netlify.app,localhost:5187
VITE_CANONICAL_URL=https://saim.nickward.co.uk
