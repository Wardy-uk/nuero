[Unit]
Description=SAiM tablet backlight (night mode for the room tablets, over ADB)
After=network-online.target

[Service]
Type=simple
# SAIM_TABLETS / SAIM_DISPLAY_URL / SAIM_TABLET_NIGHT live here (pi5).
EnvironmentFile=/etc/saim-tablets.env
ExecStart=/usr/bin/python3 -u /home/nickw/nuero/saim/sensor/saim-tablet-backlight.py
Restart=always
RestartSec=10
# nickw holds the ADB keys the tablets have authorised.
User=nickw

[Install]
WantedBy=multi-user.target
