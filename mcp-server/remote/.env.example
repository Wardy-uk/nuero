MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_PUBLIC_URL=https://pi5.tailecb90f.ts.net/mcp
# Provider must support authorization-code + S256 PKCE and MCP resource audience.
MCP_AUTH_ISSUER=https://auth.example.com/
MCP_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_AUTH_SUBJECT=replace-with-your-immutable-provider-user-id
MCP_AUTH_ALGORITHMS=RS256
MCP_AUTH_MAX_TOKEN_AGE=3600
NEURO_API_URL=http://127.0.0.1:3001
NEURO_API_TOKEN=
# Legacy alternative to the backend machine token:
NEURO_PIN=
NEURO_VAULT_KEY=
NEURO_DND_VAULT_KEY=
# Optional separate VESTA/capture application session; never the MCP OAuth token.
NEURO_CAPTURE_SESSION=
MCP_MEMORY_DIR=MCP Memories
MCP_UPSTREAM_TIMEOUT_MS=15000
MCP_RATE_LIMIT=120
MCP_TRUST_PROXY=false
LOG_LEVEL=info
# Only required for the optional tunnel profile:
TUNNEL_TOKEN=
