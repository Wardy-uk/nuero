{
  "name": "neuro-mcp-server",
  "version": "1.0.0",
  "description": "NEURO MCP Server — exposes local brain/cortex to external chat clients",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "start:remote": "node --env-file=remote/.env remote/index.js",
    "test": "node --test remote/*.test.js",
    "smoke": "node remote/smoke.js",
    "check:auth": "node --env-file=remote/.env remote/check-auth.js",
    "catalogue:refresh": "node scripts/inspect-api.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jose": "6.2.12",
    "zod": "4.3.6"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5"
  }
}
